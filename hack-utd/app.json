{
  "expo": {
    "name": "BluePrint",
    "slug": "hack-utd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/blueprint-logo.png",
    "scheme": "hackutd",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/blueprint-logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#95C90F",
        "foregroundImage": "./assets/images/blueprint-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/blueprint-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#95C90F",
          "image": "./assets/images/blueprint-logo.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
