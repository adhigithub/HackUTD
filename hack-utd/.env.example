# Copy to .env.local (git-ignored) and fill in.
# Server-only keys: do NOT prefix with EXPO_PUBLIC_ - that would ship them inside the app.

# Ask AI (Client Report) - Google Gemini. Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the Gemini model if the default is retired.
# GEMINI_MODEL=gemini-3.5-flash

# Alert summaries + work orders - Groq. Get a key: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=

# Live building data - Supabase (these two ARE meant to be public; row-level security protects the data).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
